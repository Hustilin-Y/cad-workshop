.venv/
__pycache__/
*.pyc
.pytest_cache/

# сгенерированные файлы
out/
**/out/

# чужие модели не публикуем никогда (даже в приватном репо, на случай смены видимости)
remix/*/source/
# исключение: сгенерированные нами заглушки примеров (CC0)
!remix/example-*/source/

# временные файлы тестов
tests/_tmp/
